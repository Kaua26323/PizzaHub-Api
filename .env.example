# Environment Configuration
#
# Copy this template to create the environment files needed for your workflow:
#
# .env.development - Run the API and migrations directly on the host machine.
# .env.test        - Run automated tests against the test database.
# .env.docker      - Run the API inside Docker Compose during local development.
# .env.production  - Configure a production deployment.
#
# You only need to create the files required by your workflow.
# See src/infrastructure/config/env-schema.ts for validation rules.

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
#
# Use localhost when running the API directly on the host.
# Use database when running the API inside Docker Compose.
#
# Keep DATABASE_URL credentials consistent with DB_NAME, DB_USER,
# and DB_PASSWORD when using the local PostgreSQL Compose service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pizzahub
DB_NAME=pizzahub
DB_USER=postgres
DB_PASSWORD=postgres

# Docker Compose
# Selects the environment file loaded by the API container.
# Defaults to .env.docker when omitted.
API_ENV_FILE=.env.docker

# JWT Authentication
#
# Replace the example secret with a cryptographically secure random value.
# Never reuse example credentials or development secrets in production.
JWT_ACCESS_SECRET=replace-with-a-cryptographically-random-secret
JWT_ISSUER=pizzahub-api
JWT_AUDIENCE=pizzahub-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Browser / CORS
WEB_ORIGIN=http://localhost:5173

# Product Image Storage
#
# Temporary and permanent upload directories must be located
# on the same filesystem to support atomic rename operations.
#
# When using Docker Compose, mount the product_images volume at /app/uploads.
UPLOAD_TEMP_DIRECTORY=uploads/tmp/products
UPLOAD_DIRECTORY=uploads/products
MAX_UPLOAD_SIZE=5242880

