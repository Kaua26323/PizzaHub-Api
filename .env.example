# You need to create 3 .env. files:
# .env.development, .env.test, and .env.production
# Check the src/infrastructure/config/env-schema.ts file for more details on how we handle environments

NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pizzahub
DB_NAME=database_name
DB_USER=database_user
DB_PASSWORD=database_password

JWT_ACCESS_SECRET=replace-with-a-cryptographically-random-secret
JWT_ISSUER=pizzahub-api
JWT_AUDIENCE=pizzahub-clients
ACCESS_TOKEN_TTL_SECONDS=900

REFRESH_TOKEN_TTL_SECONDS=604800 

WEB_ORIGIN=http://localhost:5173

UPLOAD_TEMP_DIRECTORY=uploads/tmp/products
UPLOAD_DIRECTORY=uploads/products
MAX_UPLOAD_SIZE=5242880